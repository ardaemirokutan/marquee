# Copy to local.env (git-ignored) and fill in; build.sh reads it. Paths in Git Bash form on Windows (/c/...).
JAVA_HOME=/path/to/jdk-21
ANDROID_HOME=/path/to/android-sdk
# Optional: your own keystore (alias "salon"). Without KEYSTORE_PASS a debug keystore is made in .keystore/.
# KEYSTORE=/path/to/salon.keystore
# KEYSTORE_PASS=change-me
